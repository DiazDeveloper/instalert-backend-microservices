{
  "openapi": "3.1.0",
  "info": {
    "title": "InstAlert Emergencies — Local Sprint 2",
    "version": "1.0.0",
    "description": "Independent service on 8083, exposed through Gateway 8080. Pending outbox is durable; broker and external notifications are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/emergencies": {
      "post": {
        "tags": [
          "Emergencies"
        ],
        "operationId": "createEmergency",
        "summary": "Registrar alerta idempotente",
        "description": "Owner is resolved from Account. Alert, request key and PENDING outbox event are committed together. Notifications are not delivered by this local increment.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "example": "sprint2-local-request-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlert"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alert created; Location header contains the resource path.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "accountId": "22222222-2222-4222-8222-222222222222",
                  "type": "PANIC",
                  "latitude": -12.0464,
                  "longitude": -77.0428,
                  "accuracyM": 15,
                  "locationRecordedAt": "2026-10-31T12:00:00Z",
                  "createdAt": "2026-10-31T12:00:01Z",
                  "cancelledAt": null,
                  "status": "ACTIVE",
                  "version": 0
                }
              }
            }
          },
          "200": {
            "description": "Existing alert returned for an equivalent retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "accountId": "22222222-2222-4222-8222-222222222222",
                  "type": "PANIC",
                  "latitude": -12.0464,
                  "longitude": -77.0428,
                  "accuracyM": 15,
                  "locationRecordedAt": "2026-10-31T12:00:00Z",
                  "createdAt": "2026-10-31T12:00:01Z",
                  "cancelledAt": null,
                  "status": "ACTIVE",
                  "version": 0
                }
              }
            }
          },
          "409": {
            "description": "Key reused for different content or concurrent update; retry as appropriate."
          },
          "400": {
            "description": "Invalid fields, filters, UUID or stale location."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session."
          },
          "503": {
            "description": "Account session validation unavailable; fails closed."
          }
        }
      },
      "get": {
        "tags": [
          "Emergencies"
        ],
        "operationId": "getMyEmergencyHistory",
        "summary": "Consultar mi historial paginado",
        "description": "Returns only alerts owned by the authenticated account; received alerts are outside this increment. Dates use ISO-8601 UTC.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized page, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                },
                "example": {
                  "content": [
                    {
                      "id": "11111111-1111-4111-8111-111111111111",
                      "accountId": "22222222-2222-4222-8222-222222222222",
                      "type": "PANIC",
                      "latitude": -12.0464,
                      "longitude": -77.0428,
                      "accuracyM": 15,
                      "locationRecordedAt": "2026-10-31T12:00:00Z",
                      "createdAt": "2026-10-31T12:00:01Z",
                      "cancelledAt": null,
                      "status": "ACTIVE",
                      "version": 0
                    }
                  ],
                  "page": 0,
                  "size": 20,
                  "totalElements": 1,
                  "totalPages": 1
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, filters, UUID or stale location."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session."
          },
          "503": {
            "description": "Account session validation unavailable; fails closed."
          }
        }
      }
    },
    "/emergencies/{alertId}": {
      "get": {
        "tags": [
          "Emergencies"
        ],
        "operationId": "getEmergency",
        "summary": "Consultar una alerta propia",
        "parameters": [
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned emergency.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "accountId": "22222222-2222-4222-8222-222222222222",
                  "type": "PANIC",
                  "latitude": -12.0464,
                  "longitude": -77.0428,
                  "accuracyM": 15,
                  "locationRecordedAt": "2026-10-31T12:00:00Z",
                  "createdAt": "2026-10-31T12:00:01Z",
                  "cancelledAt": null,
                  "status": "ACTIVE",
                  "version": 0
                }
              }
            }
          },
          "403": {
            "description": "Another account owns this alert."
          },
          "404": {
            "description": "Alert not found."
          },
          "400": {
            "description": "Invalid fields, filters, UUID or stale location."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session."
          },
          "503": {
            "description": "Account session validation unavailable; fails closed."
          }
        }
      },
      "patch": {
        "tags": [
          "Emergencies"
        ],
        "operationId": "cancelEmergency",
        "summary": "Cancelar una alerta propia",
        "description": "Only ACTIVE to CANCELLED is supported. Repeated cancellation is safe and does not produce another event.",
        "parameters": [
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "CANCELLED"
                    ]
                  }
                }
              },
              "example": {
                "status": "CANCELLED"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancelled alert.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "accountId": "22222222-2222-4222-8222-222222222222",
                  "type": "PANIC",
                  "latitude": -12.0464,
                  "longitude": -77.0428,
                  "accuracyM": 15,
                  "locationRecordedAt": "2026-10-31T12:00:00Z",
                  "createdAt": "2026-10-31T12:00:01Z",
                  "cancelledAt": "2026-10-31T12:01:00Z",
                  "status": "CANCELLED",
                  "version": 1
                }
              }
            }
          },
          "403": {
            "description": "Only owner may cancel."
          },
          "404": {
            "description": "Alert not found."
          },
          "409": {
            "description": "Concurrent update; retry."
          },
          "400": {
            "description": "Invalid fields, filters, UUID or stale location."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session."
          },
          "503": {
            "description": "Account session validation unavailable; fails closed."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateAlert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "latitude",
          "longitude",
          "locationRecordedAt"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "PANIC"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": -12.0464
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": -77.0428
          },
          "accuracyM": {
            "type": "number",
            "minimum": 0,
            "example": 15
          },
          "locationRecordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC; at most 10 minutes old or 60 seconds ahead. Use a current timestamp."
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "PANIC"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": -12.0464
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": -77.0428
          },
          "accuracyM": {
            "type": "number",
            "minimum": 0,
            "example": 15
          },
          "locationRecordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC; at most 10 minutes old or 60 seconds ahead. Use a current timestamp."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      }
    }
  }
}